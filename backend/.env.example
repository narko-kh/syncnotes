# آدرس اتصال به دیتابیس PostgreSQL
DATABASE_URL="postgresql://syncnotes:syncnotes@localhost:5432/syncnotes?schema=public"

# کلیدهای امضای توکن (حداقل ۳۲ کاراکتر، تصادفی و متفاوت از هم)
# برای ساخت: openssl rand -base64 48
JWT_ACCESS_SECRET="change-me-to-a-long-random-string-1"
JWT_REFRESH_SECRET="change-me-to-a-long-random-string-2"

# مدت اعتبار توکن‌ها
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="7d"

# پورت سرور
PORT=3000

# دامنه‌های مجاز برای مرورگر (با کاما جدا کن). اپ موبایل به این نیازی ندارد.
CORS_ORIGINS="http://localhost:3001"
